{
  "name": "quick-memo",
  "version": "1.16.2",
  "description": "A CLI tool for quick note taking with tags and search",
  "main": "src/index.js",
  "bin": {
    "memo": "./bin/memo"
  },
  "scripts": {
    "test": "nyc --reporter=text --reporter=html --include=src/**/*.js node tests/run-all.js",
    "start": "node bin/memo",
    "benchmark": "node benchmarks/search-benchmark.js",
    "benchmark:index": "node benchmarks/index-rebuild.js",
    "benchmark:ops": "node benchmarks/add-edit-delete.js",
    "benchmark:all": "npm run benchmark && npm run benchmark:index && npm run benchmark:ops"
  },
  "keywords": [
    "productivity",
    "notes",
    "cli"
  ],
  "author": "OpenClaw",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fs-extra": "^11.0.0",
    "ora": "^8.0.1",
    "string-similarity": "^4.0.4"
  },
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "fast-check": "^4.7.0",
    "nyc": "^18.0.0"
  }
}
